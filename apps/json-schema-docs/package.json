{
  "name": "json-schema-docs",
  "type": "module",
  "private": true,
  "description": "Documentation site for @silver-formily/json-schema",
  "scripts": {
    "dev": "vitepress dev .",
    "preview": "vitepress preview .",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "check-types": "vue-tsc --noEmit",
    "docs:build": "vitepress build ."
  },
  "dependencies": {
    "@silver-formily/core": "workspace:*",
    "@silver-formily/docs-toolkit": "workspace:*",
    "@silver-formily/json-schema": "workspace:*",
    "@silver-formily/reactive": "workspace:*",
    "@silver-formily/reactive-vue": "workspace:*",
    "@silver-formily/shared": "workspace:*",
    "@silver-formily/vue": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@silver-formily/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vitepress": "catalog:",
    "vue-tsc": "catalog:"
  }
}
