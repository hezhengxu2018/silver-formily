{
  "extends": "@silver-formily/typescript-config/docs.json",
  "compilerOptions": {
    "paths": {
      "@silver-formily/reactive-vue": ["../../packages/reactive-vue/src"],
      "@silver-formily/reactive-vue/*": ["../../packages/reactive-vue/src/*"]
    }
  },
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue",
    "components.d.ts",
    "env.d.ts"
  ],
  "exclude": ["node_modules", ".vitepress/cache", ".vitepress/dist"]
}
