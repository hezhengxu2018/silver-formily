{
  "name": "vant-docs",
  "type": "module",
  "private": true,
  "description": "Documentation site for @silver-formily/vant",
  "scripts": {
    "dev": "vitepress dev .",
    "preview": "vitepress preview .",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "check-types": "vue-tsc --noEmit",
    "docs:build": "vitepress build ."
  },
  "dependencies": {
    "@silver-formily/core": "workspace:*",
    "@silver-formily/docs-toolkit": "workspace:*",
    "@silver-formily/json-schema": "workspace:*",
    "@silver-formily/reactive": "workspace:*",
    "@silver-formily/reactive-vue": "workspace:*",
    "@silver-formily/shared": "workspace:*",
    "@silver-formily/vant": "workspace:*",
    "@silver-formily/vue": "workspace:*",
    "@vant/area-data": "catalog:",
    "@vant/touch-emulator": "catalog:",
    "vant": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@silver-formily/typescript-config": "workspace:*",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:",
    "vue-tsc": "catalog:"
  }
}
