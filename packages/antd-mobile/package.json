{
  "name": "@silver-formily/antd-mobile",
  "type": "module",
  "version": "1.0.0",
  "description": "Ant Design Mobile based form components and scene bindings for Silver Formily on React",
  "author": "hezhengxu",
  "license": "MIT",
  "homepage": "https://github.com/hezhengxu2018/silver-formily",
  "repository": {
    "type": "github",
    "url": "https://github.com/hezhengxu2018/silver-formily",
    "directory": "packages/antd-mobile"
  },
  "bugs": {
    "url": "https://github.com/hezhengxu2018/silver-formily/issues"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "**/style.ts",
    "./esm/*/style.mjs"
  ],
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.mjs",
      "default": "./esm/index.mjs"
    },
    "./*": "./esm/*",
    "./package.json": "./package.json"
  },
  "main": "./esm/index.mjs",
  "types": "./esm/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "check-types": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "test:browser": "vitest run --browser.headless",
    "test:coverage": "vitest run --coverage --browser.headless",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@silver-formily/core": "workspace:^",
    "@silver-formily/json-schema": "workspace:^",
    "@silver-formily/path": "workspace:^",
    "@silver-formily/react": "workspace:^",
    "@silver-formily/reactive": "workspace:^",
    "@silver-formily/reactive-react": "workspace:^",
    "@silver-formily/shared": "workspace:^",
    "@types/react": ">=18",
    "@types/react-dom": ">=18",
    "antd-mobile": "^5.43.0",
    "antd-mobile-icons": "^0.3.0",
    "dayjs": "^1",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "classnames": "catalog:"
  },
  "devDependencies": {
    "@silver-formily/core": "workspace:*",
    "@silver-formily/json-schema": "workspace:*",
    "@silver-formily/path": "workspace:*",
    "@silver-formily/react": "workspace:*",
    "@silver-formily/reactive": "workspace:*",
    "@silver-formily/reactive-react": "workspace:*",
    "@silver-formily/shared": "workspace:*",
    "@silver-formily/typescript-config": "workspace:*",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "antd-mobile": "catalog:",
    "antd-mobile-icons": "catalog:",
    "dayjs": "catalog:",
    "eslint": "catalog:",
    "less": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
