{
  "extends": "@silver-formily/typescript-config/legacy-library.json",
  "compilerOptions": {
    "paths": {
      "@silver-formily/core": [
        "./src/index.ts"
      ],
      "@silver-formily/path": [
        "../path/src/index.ts"
      ],
      "@silver-formily/reactive": [
        "../reactive/src/index.ts"
      ],
      "@silver-formily/shared": [
        "../shared/src/index.ts"
      ],
      "@silver-formily/validator": [
        "../validator/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "esm"
  ]
}
