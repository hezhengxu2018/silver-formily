{
  "extends": "@silver-formily/typescript-config/vue-library.json",
  "compilerOptions": {
    "paths": {
      "@silver-formily/vant": [
        "./src"
      ],
      "@silver-formily/vant/*": [
        "./src/*"
      ],
      "@silver-formily/reactive-vue": [
        "../reactive-vue/src"
      ],
      "@silver-formily/reactive-vue/*": [
        "../reactive-vue/src/*"
      ],
      "@silver-formily/vue": [
        "../vue/src"
      ],
      "@silver-formily/vue/*": [
        "../vue/src/*"
      ]
    }
  },
  "include": [
    "src",
    "type-tests"
  ],
  "exclude": [
    "node_modules",
    "esm"
  ]
}
